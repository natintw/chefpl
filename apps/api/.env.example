# ============================================================
# 帳務損益系統 .env.example
# 本機：複製成 .env；Railway：逐一設在服務的 Variables（ledger、ledger-worker-* 共用）
# ============================================================

# ===== 執行環境 =====
APP_ENV=local                          # local / staging / production
USE_MOCKS=true                         # true：發票系統、現金流主檔、AI、檔案全用 Mock，不需任何金鑰
PORT=8080                              # Railway 私有網路固定埠

# ===== 資料庫：Neon【DBA】=====
# 直接貼 Neon 給的連線字串即可（postgresql://… 會自動轉成 postgresql+psycopg://…）
# 應用程式：pooled 連線（主機名稱含 -pooler），帳號用 ledger_app（只有 DML 權限，見 scripts/neon_roles.sql）
DATABASE_URL=postgresql://ledger_app:***@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/ledger?sslmode=require
# migration：direct 連線（主機名稱不含 -pooler），帳號用 ledger_owner（可建表）
DATABASE_URL_DIRECT=postgresql://ledger_owner:***@ep-xxxx.ap-southeast-1.aws.neon.tech/ledger?sslmode=require
GUARD_DATABASE_URL=                    # 選填：守門層另用一個帳號；空白則與 DATABASE_URL 相同
DB_POOL_SIZE=5                         # 每個服務的連線池大小；Neon pooler 可承受較多連線

# ===== 跨系統（Railway 私有網路）=====
INTEGRATION_MODE=private               # private：/integration/* 只接受 *.railway.internal；public：改走公開網址並要求 HMAC
INVOICE_BASE_URL=http://invoice.railway.internal:8080
INVOICE_API_KEY=                       # TODO（工程師）：sk_ledger_invoice_…
INVOICE_SYNC_BATCH=200
COMPANY_DIRECTORY_MODE=mock            # mock / cashflow_api（現金流系統提供 /integration/v1/companies、stores 後改為 cashflow_api）
CASHFLOW_BASE_URL=http://cashflow.railway.internal:8080
CASHFLOW_API_KEY=                      # TODO（工程師）：sk_ledger_cashflow_…
# 允許呼叫本系統的金鑰（只存 SHA-256），見《系統對接說明》3.3
INTEGRATION_CLIENTS=[{"client":"cashflow","key_sha256":["<sha256>"],"allow":["GET /integration/v1/open-items","GET /integration/v1/balances","POST /integration/v1/settlements","POST /integration/v1/bank-only-items"]}]
INTEGRATION_SIGNING_SECRET=            # 只在 INTEGRATION_MODE=public 時需要

# ===== 帳務規則 =====
TAX_RATE=0.05
AMOUNT_TOLERANCE=1                     # 明細合計＋稅額 與 應付金額 的容許差（元）
DEFAULT_PAYMENT_RULE=next_month_30     # next_month_30 / next_month_10 / next_month_5 / same_month_end
CAPEX_THRESHOLD=80000                  # 設備達此金額需資本化並填耐用年限【待會計師確認】
ACCRUAL_LOOKBACK_MONTHS=3              # 預估入帳建議金額取前幾個月平均
OPENING_DATE=2026-11-01                # 開帳日【待確認】

# ===== AI（科目建議）=====
ANTHROPIC_API_KEY=                     # 空白則使用 Mock 建議
AI_MODEL=claude-haiku-4-5
AI_PROMPT_VERSION=v1
AI_TIMEOUT_SEC=15
AI_MIN_CONFIDENCE=0.70

# ===== 檔案：Railway Storage Bucket =====
FILE_STORE_MODE=local                  # local / s3
LOCAL_FILE_DIR=./.files
BUCKET=                                # Railway：${{ledger-files.BUCKET}}
ACCESS_KEY_ID=                         # ${{ledger-files.ACCESS_KEY_ID}}
SECRET_ACCESS_KEY=                     # ${{ledger-files.SECRET_ACCESS_KEY}}
ENDPOINT=                              # ${{ledger-files.ENDPOINT}}
REGION=auto                            # ${{ledger-files.REGION}}
MAX_UPLOAD_MB=20

# ===== 使用者登入 =====
AUTH_MODE=dev                          # dev（X-Dev-User 標頭，僅限本機）/ google（Google ID token）
GOOGLE_OAUTH_CLIENT_ID=                # TODO（工程師）：Google Cloud Console 建立的 OAuth Client ID
ALLOWED_EMAIL_DOMAIN=chefteng.com
BOOTSTRAP_ADMINS=bill@chefteng.com     # 第一次登入自動建立為 admin
